# Public site URL (used for canonical URLs, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://www.martechbuildingsystems.com

# GA4 — leave empty to disable analytics entirely (no consent banner exists yet; see docs/redesign/10 §5)
NEXT_PUBLIC_GA_ID=

# Lead storage (server-only). When unset in development, leads are written to .data/leads.ndjson.
# In production the lead endpoint refuses submissions unless these are set, so no lead is silently lost.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Search indexing is OFF unless this is exactly "true". Set it only on the production domain at cutover.
NEXT_PUBLIC_ALLOW_INDEXING=
